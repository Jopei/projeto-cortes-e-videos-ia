# Postgres
POSTGRES_USER=cortes
POSTGRES_PASSWORD=cortes
POSTGRES_DB=cortes
DATABASE_URL=postgresql+psycopg2://cortes:cortes@postgres:5432/cortes

# Redis
REDIS_URL=redis://redis:6379/0

# S3 storage (SeaweedFS; bucket "media" created automatically by the storage-init service)
S3_ENDPOINT=http://storage:8333
S3_ACCESS_KEY=cortesadmin
S3_SECRET_KEY=cortesadmin
S3_BUCKET=media
S3_REGION=us-east-1

# --- Chaves de integrações (LLM/OAuth) ---
# Todas as chaves abaixo podem, alternativamente, ser cadastradas pela UI por
# um admin (GET/PUT/DELETE /api/admin/integrations) — o valor salvo no banco
# tem prioridade sobre o env var equivalente (ver services/api/app/integrations.py
# ::get_integration_value). Estas variáveis continuam funcionando como
# fallback/deploy sem UI.

# LLM usado para gerar títulos/descrições/hashtags (Fase 3)
ANTHROPIC_API_KEY=

# OAuth — YouTube Data API v3 (Google Cloud Console)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# OAuth — TikTok Content Posting API (TikTok for Developers)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# OAuth — Instagram Reels (Meta Graph API)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# OAuth — Facebook Reels (Meta Graph API)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# OAuth — Bilibili (opcional/futuro, sem Open Platform aprovada ainda)
BILIBILI_CLIENT_ID=
BILIBILI_CLIENT_SECRET=

# OAuth — Vimeo (developer.vimeo.com/apps)
VIMEO_CLIENT_ID=
VIMEO_CLIENT_SECRET=

# Base URL pública da API, usada para montar os `redirect_uri` de OAuth
# exibidos em GET /api/admin/integrations (precisa bater com o registrado no
# app de cada plataforma)
PUBLIC_API_URL=http://localhost:18000

# Chave simétrica usada para cifrar os tokens OAuth de PlatformAccount no banco
TOKEN_ENCRYPTION_KEY=

# Frontend (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:18000
NEXT_PUBLIC_TUS_URL=http://localhost:11080/files/

# JSON list of origins allowed to call the API from the browser
CORS_ORIGINS=["http://localhost:13000"]

# Auth (session cookie / JWT) — see CLAUDE.md "Auth"
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=gere-um-valor-aleatorio-com-32-ou-mais-caracteres
# Set to true only when serving the panel over HTTPS
COOKIE_SECURE=false

# Optional: dedicated HMAC key for tusd upload tickets (app/uploads_security.py).
# Leave unset to derive one from SECRET_KEY automatically — only set this if you
# want to rotate the upload-ticket secret independently of session signing.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
TUSD_HOOK_SECRET=

# Initial admin account, created via `python -m app.cli create-admin`
# (does not overwrite an existing password unless run with --reset)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-me

# Regex of origins tusd should answer to for CORS (used with -cors-allow-origin)
TUSD_CORS_ORIGIN_REGEX=^http://localhost:13000$

# Worker concurrency (number of parallel Celery worker processes — each can
# load its own whisper model + run ffmpeg, so keep this modest on small
# machines). Defaults to 2 when unset.
CELERY_WORKER_CONCURRENCY=2

# Speech transcription (app/worker/analysis/speech.py). WHISPER_MODEL sizes:
# tiny|base|small|medium|large-v3 (bigger = slower + more accurate).
WHISPER_ENABLED=true
WHISPER_MODEL=small

# Cotas padrão para usuários novos criados via POST /api/admin/users, quando
# o admin não informa um valor explícito (null explícito = ilimitado e é
# respeitado como tal, nunca substituído por estes defaults). Ver CLAUDE.md
# "Multiusuário".
DEFAULT_STORAGE_QUOTA_GB=50
DEFAULT_DAILY_ANALYSIS_QUOTA=10
DEFAULT_MAX_CHANNELS=4

# --- Series IA (worker-story, filas `story` e `genmedia`) ---
# Modelo usado para planejar a serie (premissa -> plano)
STORY_PLANNER_MODEL=claude-opus-5-5
# Modelo usado para escrever/validar roteiros de episodio
STORY_WRITER_MODEL=claude-sonnet-5
# Habilita provedores falsos (video/imagem/TTS) sem custo. Ligar so em dev/testes;
# manter false em staging/producao.
STORY_FAKE_PROVIDERS_ENABLED=true
# Sem chave da Anthropic, o plano/roteiro vem de respostas deterministicas (provider
# fake_llm, custo 0). Ligar so em dev/testes; manter false em staging/producao.
STORY_FAKE_LLM_ENABLED=false
# Tentativas maximas de validacao de um roteiro antes de falhar o episodio
STORY_MAX_VALIDATION_ATTEMPTS=3
# Concorrencia do servico worker-story (processos Celery paralelos)
STORY_WORKER_CONCURRENCY=4
# Jobs de geracao de midia simultaneos por provedor (padrao)
GENMEDIA_MAX_INFLIGHT_DEFAULT=2
# Polling de jobs de midia: intervalo inicial e maximo (segundos, com backoff)
GENMEDIA_POLL_INITIAL_S=15
GENMEDIA_POLL_MAX_S=120
# Tempo maximo (segundos) de um job de midia antes de ser dado como falho
GENMEDIA_JOB_TIMEOUT_S=1800
# Limites padrao para usuarios novos: series ativas simultaneas, orcamento por
# serie e orcamento mensal de IA, em USD (vazio = sem limite)
DEFAULT_MAX_ACTIVE_SERIES=1
DEFAULT_SERIES_BUDGET_USD=
DEFAULT_MONTHLY_AI_BUDGET_USD=
# Provedores de midia (podem ser cadastrados pela UI de integracoes)
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# Host ports (chosen to avoid clashing with other local projects)
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
STORAGE_HOST_PORT=19000
TUSD_HOST_PORT=11080
API_HOST_PORT=18000
WEB_HOST_PORT=13000
